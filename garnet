#!/usr/bin/env bash
# garnet — TypeScript → C AOT compiler driver.
#
#   garnet foo.ts            Emit foo.c and compile it to a native executable `foo`.
#   garnet -c foo.ts         Emit foo.c only (no native compile/link).
#   garnet -o bar.c foo.ts   Use bar.c as the C output name (executable: bar).
#   garnet -S foo.ts         Write the generated C to stdout (no files).
#
# Pipeline: exporter (TS → IR JSON) → analyzer `emit` (IR → C) → cc (C → binary).
# Reuses the repo's link-flag helpers so optional RegExp / Unicode / fetch runtime
# objects are compiled and linked exactly as the test harnesses do.
#
# Env:
#   TSAOT_CC               C compiler+flags (default "cc -O2"; e.g. "gcc -O2").
#   TSAOT_ANALYZER         rust (default) | ts (frozen twin) | native.
#   TSAOT_PROP_PIC=0       Disable production-default property PIC emission.
#   TSAOT_FRAME_ROOTS=0    Disable production-default batched GC root frames.
#   TSAOT_PRETENURE=0      Disable escape-guided old-generation allocation.
#   TSAOT_LAZY_PROTO=0     Allocate every function's .prototype eagerly instead
#                          of on first observation (legacy emission).
#   TSAOT_CLOSURE_ENV_ABI=0  Pass captured cells merged into the argument array
#                          instead of through the environment register (legacy).
#   TSAOT_EH_RETURN_POP=0  Leave try handlers unpopped on `return` (the frozen
#                          emitter's miscompile; parity oracle only).
#   TSAOT_UNDEF_FIELDS=0   Skip the `undefined` initialization of boxed class
#                          fields (unassigned fields read as 0; parity oracle only).
#   TSAOT_INLINE_SLOTS=0   Allocate object literals without in-object value
#                          slots (`ts_new_object()`; parity oracle only).
#   TSAOT_FRAME_COALESCE=0 One rooted frame slot per reference local instead
#                          of liveness-shared slots (parity oracle only).
#   TSAOT_DIRECT_ENTRY=0   Single generic `(args, nargs)` entry per function
#                          instead of typed direct-call entries (parity oracle only).
#   TSAOT_TYPEOF_TEST=0    Keep `typeof x === "lit"` as a string compare instead
#                          of a tag test (parity oracle only).
#   TSAOT_SWITCH_TABLE=0   Nested ifs instead of a C `switch` for integer
#                          if/else-if chains (parity oracle only).
#   TSAOT_LAZY_FRAMES=0    Link every root frame eagerly instead of only
#                          around slow paths in collection-free functions
#                          (parity oracle only).
#   TSAOT_LITERAL_LAYOUT=0 One cached property addition per literal or
#                          constructor property instead of allocating in the
#                          final shape (parity oracle only).
#   TSAOT_TRUTHY_UNBOX=0   Box `!` results and `&&`/`||` temporaries that only
#                          feed conditions (parity oracle only).
#   TSAOT_INT32_USES=0     Keep the per-use ToInt32 of number locals whose every
#                          use is a bitwise operand (default: convert once at
#                          the definition, cast at the uses).
#   TSAOT_TAG_EQ=0         Generic strict/loose equality against undefined,
#                          null and boolean constants instead of a bit compare
#                          (parity oracle only).
#   TSAOT_INLINE_INDEX=0   Out-of-line array element reads instead of the
#                          inline in-range fast path (parity oracle only).
#   TSAOT_KNOWN_METHOD=0   Dynamic dispatch for every method call instead of
#                          the guarded direct call of a method key that holds
#                          one closure program-wide (parity oracle only).
#   TSAOT_TYPED_RETURNS=0  Boxed return values from every direct entry instead
#                          of raw numbers and booleans (parity oracle only).
#   TSAOT_LOOP_STACK=1     Per-iteration stack slot for a non-escaping loop-body
#                          allocation (legacy; unsound when a reference outlives
#                          the iteration; parity oracle only).
#   TSAOT_STACK_CLOSURES=0 Heap-allocate closures whose site never escapes
#                          its frame, and declare class-instance stack cells in
#                          their block instead of at function scope (parity
#                          oracle only).
#   TSAOT_VALUE_CALL_FAST=0  Every call through a function value goes through
#                          ts_call_value instead of entering a plain closure's
#                          generic entry directly (parity oracle only).
#   TSAOT_TYPED_CELLS=0    Exporter: plain-object cells instead of typed `__cell`
#                          instances (legacy IR; the parity corpus uses it).
#   TSAOT_CAPTURE_CONTEXTS=0  Exporter: one cell per captured variable instead of
#                          one scope record per activation (legacy IR).
#   TSAOT_NESTED_DIRECT=0  Exporter: call nested function declarations through
#                          their closure values instead of directly (legacy IR).
#   TSAOT_LAZY_FN_DECL=0   Exporter: hoist every function declaration as a
#                          closure even when it is only ever called directly.
#   TSAOT_NAMESPACE_DIRECT=0  Exporter: call namespace member functions through
#                          their closure values instead of directly (legacy IR).
#   TSAOT_ARRAY_INTERFACES=0  Exporter: treat an interface that extends Array or
#                          ReadonlyArray as a dynamic receiver instead of an
#                          array (legacy IR).
#   TSAOT_VALUE_CAPTURES=0  Exporter: keep every captured binding in a cell or
#                          scope record instead of passing immutable bindings
#                          (parameters, constants) to closures by value
#                          (legacy IR).
#   TSAOT_LAZY_FN_VALUES=0  Exporter: create the closure of every nested function
#                          declaration used as a value at the owner's entry
#                          instead of on first use (legacy IR).
#   TSAOT_CTOR_CAPACITY=N  Exporter: pre-size guarded constructions to their
#                          longest producer layout, at most N in-object slots
#                          (default 0 = off: costs memory, measured no time).
#   TSAOT_STATIC_SLOTS=0   Exporter/emitter: no static-slot hints at property
#                          sites typed by constructor functions (default: the
#                          predicted in-object slot is probed before the cache).
#   TSAOT_NEW_GUARDS=0     Exporter: no guarded direct construction for `new`
#                          through a function value (default: test the value
#                          against the constructor functions of the site's type
#                          and call the body directly on a hit).
#   TSAOT_SPECIALIZE_CALLBACKS=0  Exporter: do not clone a function per
#                          module-level function passed as a callback (default:
#                          clone, binding the parameter to the function).
#   TSAOT_SPLICE_FAST=0     Exporter: lower every array splice to the general
#                          builtin even when its result is discarded (legacy IR).
#   TSAOT_TINY_INLINE=1     Emitter: mark tiny leaf direct entries always_inline
#                          (an experiment that ran the compiler 1.5% slower;
#                          off by default).
#   TSAOT_GC_AGE_THRESHOLD=1  Disable the default one-minor aging grace at
#                          application runtime (immediate first-survival promotion).
#   TSAOT_GC_AGING_ADAPTIVE=0 Disable runtime survival feedback and use the
#                          fixed aging threshold/capacity policy.
#   TSAOT_USE_MIMALLOC=0   Use the libc allocator instead of the default
#                          statically linked mimalloc allocator.
#   TSAOT_ALLOW_UNSUPPORTED=1  Emit even with UNSUPPORTED constructs (unsafe).
#   TSAOT_UNTYPED=1        Compile as `any` — all type-driven optimization off
#                          (boxed, JS semantics; safe but slow). Same as --untyped.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROG="$(basename "$0")"

usage() {
  cat >&2 <<EOF
usage: $PROG [-c | -S] [-o <out.c>] [-p <tsconfig>] <input.ts>

  (default)     emit <input>.c and compile it to a native executable
  -c            emit the C file only (skip native compile/link)
  -S            write the generated C to stdout (no files written)
  -p, --project use compiler options from a tsconfig file or directory
  -o <out.c>    name the C output file (default: <input basename>.c;
                the executable is the same name without the .c suffix)
  --untyped     compile the whole program as \`any\`: disable all type-driven
                optimization (everything boxed, correct JS semantics). Safe but
                slower; also lets ill-typed input through (no type-error stop).
  --profile     compile with -g -fno-omit-frame-pointer (for sample/perf;
                see scripts/profile_bench.sh)
  --rt-stats    compile the runtime with -DTSAOT_RT_STATS: counters (GC/alloc/
                probe lengths/…) are printed to stderr at exit
                (TSAOT_RT_STATS_FILE=path appends there instead)
  -h, --help    show this help

env: TSAOT_CC (default "cc -O2"), TSAOT_ANALYZER=rust|ts|native (default rust),
     TSAOT_PROP_PIC=0 or TSAOT_FRAME_ROOTS=0 for legacy diagnostic emission,
     TSAOT_PRETENURE=0 to disable escape-guided pretenuring,
     TSAOT_LAZY_PROTO=0 for eager function .prototype allocation,
     TSAOT_CLOSURE_ENV_ABI=0 for the merged closure argument convention,
     TSAOT_EH_RETURN_POP=0 for the frozen (unpopped-handler) return emission,
     TSAOT_UNDEF_FIELDS=0 for the frozen (zeroed) class field initialization,
     TSAOT_INLINE_SLOTS=0 for literals without in-object slots,
     TSAOT_FRAME_COALESCE=0 for one frame slot per local,
     TSAOT_DIRECT_ENTRY=0 for the single generic entry per function,
     TSAOT_TYPEOF_TEST=0 for string-compare typeof tests,
     TSAOT_SWITCH_TABLE=0 for nested-if integer chains,
     TSAOT_LAZY_FRAMES=0 for eagerly linked root frames,
     TSAOT_LITERAL_LAYOUT=0 for per-property literal construction,
     TSAOT_TRUTHY_UNBOX=0 for boxed condition temporaries,
     TSAOT_TAG_EQ=0 / TSAOT_INLINE_INDEX=0 for generic tag compares and
     out-of-line element reads,
     TSAOT_KNOWN_METHOD=0 for dynamic dispatch at every method call,
     TSAOT_TYPED_RETURNS=0 for boxed direct-entry returns,
     TSAOT_LOOP_STACK=1 for the legacy loop-body stack slots,
     TSAOT_STACK_CLOSURES=0 for heap closures at non-escaping sites,
     TSAOT_VALUE_CALL_FAST=0 for ts_call_value at every function-value call,
     TSAOT_TYPED_CELLS=0 / TSAOT_CAPTURE_CONTEXTS=0 for the legacy capture IR,
     TSAOT_NESTED_DIRECT=0 / TSAOT_LAZY_FN_DECL=0 for closure-value nested calls,
     TSAOT_NAMESPACE_DIRECT=0 for closure-value namespace member calls,
     TSAOT_ARRAY_INTERFACES=0 for dynamic array-interface receivers,
     TSAOT_GC_AGE_THRESHOLD=1 for immediate promotion at application runtime,
     TSAOT_GC_AGING_ADAPTIVE=0 for fixed-threshold aging at application runtime,
     TSAOT_USE_MIMALLOC=0 to disable default static mimalloc,
     TSAOT_ALLOW_UNSUPPORTED=1, TSAOT_UNTYPED=1
EOF
}

die() { echo "$PROG: $*" >&2; exit 1; }

# ----- parse arguments -----
emit_only=0      # -c
to_stdout=0      # -S
profile=0        # --profile
rt_stats=0       # --rt-stats
out_c=""         # -o
input=""
project=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c) emit_only=1 ;;
    -S) to_stdout=1 ;;
    -o) shift; [ $# -gt 0 ] || die "-o requires an argument"; out_c="$1" ;;
    -o*) out_c="${1#-o}" ;;
    -p|--project) shift; [ $# -gt 0 ] || die "--project requires an argument"; project="$1" ;;
    --untyped) export TSAOT_UNTYPED=1 ;;
    --profile) profile=1 ;;
    --rt-stats) rt_stats=1 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown option: $1 (try $PROG --help)" ;;
    *) [ -z "$input" ] || die "multiple input files given ('$input', '$1'); only one is supported"; input="$1" ;;
  esac
  shift
done
[ -n "${input:-}" ] || { [ $# -gt 0 ] && input="$1" || { usage; exit 1; }; }
[ "$emit_only" -eq 1 ] && [ "$to_stdout" -eq 1 ] && die "-c and -S are mutually exclusive"

# ----- validate input -----
[ -f "$input" ] || die "no such file: $input"
case "$input" in *.ts) ;; *) die "input must be a .ts file: $input" ;; esac

# ----- locate built tools -----
EXPORTER="$ROOT/exporter/exporter.js"
command -v node >/dev/null 2>&1 || die "node not found on PATH"
[ -f "$EXPORTER" ] || die "exporter not built ($EXPORTER missing). Run: scripts/setup.sh"
# Keep the production emitter configuration explicit at the public driver
# boundary. The analyzer has matching defaults; these exports make the contract
# visible and prevent an internal fallback change from silently disabling them.
TSAOT_PROP_PIC="${TSAOT_PROP_PIC:-1}"
TSAOT_FRAME_ROOTS="${TSAOT_FRAME_ROOTS:-1}"
TSAOT_PRETENURE="${TSAOT_PRETENURE:-1}"
export TSAOT_PROP_PIC TSAOT_FRAME_ROOTS TSAOT_PRETENURE
# Analyzer selection (TSAOT_ANALYZER): the Rust analyzer is the main
# implementation and the default since session 315 (roles inverted; flipped
# here in s318 — the frozen analyzer_ts still carries silent-miscompile fixes
# #1-#4 that only the Rust side received, see scripts/frozen_known_diffs.tsv).
# analyzer_ts stays selectable as the frozen parity twin / selfhost bench input.
#   rust   analyzer/target/release/tsaot (main; typed fast paths)  <- default
#   ts     node + analyzer_ts/dist (frozen twin, boxed/untyped)
#   native a garnet-compiled tsan binary (set TSAOT_TSAN_NATIVE to its path)
case "${TSAOT_ANALYZER:-rust}" in
  rust)
    ANALYZER="$ROOT/analyzer/target/release/tsaot"
    [ -x "$ANALYZER" ] || die "analyzer not built ($ANALYZER missing). Run: scripts/setup.sh"
    run_analyzer() { "$ANALYZER" "$1" emit; }
    ;;
  native)
    NATIVE_TSAN="${TSAOT_TSAN_NATIVE:-}"
    [ -x "$NATIVE_TSAN" ] || die "TSAOT_ANALYZER=native needs TSAOT_TSAN_NATIVE=<path to garnet-compiled tsan>"
    run_analyzer() { "$NATIVE_TSAN" < "$1"; }
    ;;
  ts)
    TS_ANALYZER="$ROOT/analyzer_ts/dist/main.js"
    [ -f "$TS_ANALYZER" ] || die "TS analyzer not built ($TS_ANALYZER missing). Run: cd analyzer_ts && ./node_modules/.bin/tsc -p tsconfig.json"
    run_analyzer() { node "$TS_ANALYZER" "$1" emit; }
    ;;
  *) die "unknown TSAOT_ANALYZER '${TSAOT_ANALYZER}' (rust|ts|native)" ;;
esac

# absolute input path (module resolution / output naming are CWD-independent)
input_abs="$(cd "$(dirname "$input")" && pwd)/$(basename "$input")"
base="$(basename "$input")"; base="${base%.ts}"

# default C output name (in the current directory, gcc-style)
[ -n "$out_c" ] || out_c="$base.c"

# ----- stage 1: TS → IR JSON (in a scratch dir) -----
work="$(mktemp -d "${TMPDIR:-/tmp}/garnet.XXXXXX")"
trap 'rm -rf "$work"' EXIT
# The self-hosted analyzers are conservative/boxed: export untyped IR for them
# (typed-IR-only instructions would be loud-rejected). The Rust path keeps the
# caller's TSAOT_UNTYPED choice (typed fast paths by default).
case "${TSAOT_ANALYZER:-rust}" in
  ts|native) export TSAOT_UNTYPED=1 ;;
esac
# Exporter prints diagnostics to stderr and exits non-zero on UNSUPPORTED.
if [ -n "$project" ]; then
  node "$EXPORTER" --project "$project" "$input_abs" "$work/ir.json" "$work/labels.json" 1>&2
else
  node "$EXPORTER" "$input_abs" "$work/ir.json" "$work/labels.json" 1>&2
fi

# ----- stage 2: IR JSON → C -----
if [ "$to_stdout" -eq 1 ]; then
  run_analyzer "$work/ir.json"   # to stdout; scratch dir cleaned by EXIT trap
  exit $?
fi
out_dir="$(dirname "$out_c")"; [ -d "$out_dir" ] || mkdir -p "$out_dir"
run_analyzer "$work/ir.json" > "$out_c"

if [ "$emit_only" -eq 1 ]; then
  echo "$PROG: wrote $out_c" >&2
  exit 0
fi

# ----- stage 3: C → native executable -----
binary="${out_c%.c}"; [ "$binary" = "$out_c" ] && binary="$out_c.out"

CC="${TSAOT_CC:-cc -O2}"
# Native application builds use statically linked mimalloc by default. Keep
# test harnesses independently selectable by setting the default here rather
# than in the shared helper.
TSAOT_USE_MIMALLOC="${TSAOT_USE_MIMALLOC:-1}"
export TSAOT_USE_MIMALLOC
# --rt-stats / --profile append flags; the cached runtime object gets a distinct
# name per flag combination so variants never poison each other's cache.
rt_suffix=""
if [ "$rt_stats" -eq 1 ]; then CC="$CC -DTSAOT_RT_STATS"; rt_suffix="${rt_suffix}_stats"; fi
if [ "$profile" -eq 1 ]; then CC="$CC -g -fno-omit-frame-pointer"; rt_suffix="${rt_suffix}_prof"; fi
export ROOT CC
. "$ROOT/scripts/lib/mimalloc_flags.sh" || die "failed to load mimalloc flags"
. "$ROOT/scripts/lib/regexp_link_flags.sh" || die "failed to load regexp link flags"
if [[ "${TSAOT_MIMALLOC_ACTIVE:-0}" == "1" ]]; then
  rt_suffix="${rt_suffix}_mi"
fi
rt_cc_key="$(
  printf '%s\n' "$CC|$(uname -s)|$(uname -m)" |
    cksum | awk '{print $1}'
)"

# Base runtime object (also the default when the program does not need fetch).
RT_OBJ="$ROOT/build/rt${rt_suffix}_${rt_cc_key}.o"
mkdir -p "$ROOT/build"
if [ ! -f "$RT_OBJ" ] ||
   [ "$ROOT/runtime/ts_rt.c" -nt "$RT_OBJ" ] ||
   [ "$ROOT/runtime/ts_rt.h" -nt "$RT_OBJ" ]; then
  $CC -c "$ROOT/runtime/ts_rt.c" -I"$ROOT/runtime" -o "$RT_OBJ" || die "failed to build runtime ($RT_OBJ)"
fi

# Optional runtime objects, gated by markers the emitted C declares.
tsaot_prepare_regexp_objs "$out_c" "$work" || die "failed to prepare RegExp runtime"
tsaot_prepare_unicode_objs "$out_c" "$work" || die "failed to prepare Unicode runtime"
tsaot_prepare_fetch_runtime "$out_c" "$work" "$RT_OBJ" || die "failed to prepare fetch runtime"

# shellcheck disable=SC2086  # object/lib arg vars are intentionally word-split
$CC "$out_c" "$TSAOT_FETCH_RT_OBJ_ARG" $TSAOT_REGEXP_OBJ_ARGS $TSAOT_UNICODE_OBJ_ARGS \
  -I"$ROOT/runtime" -lm $TSAOT_FETCH_LDLIBS ${TSAOT_LDLIBS:-} -o "$binary" \
  || die "C compilation failed"

echo "$PROG: wrote $out_c and $binary" >&2
