+/** The pages of a `NearLinkTable`: 64 ids. */
+export const enum NearPaging {
+  Bits = 6,
+  Size = 1 << Bits,
+  Mask = Size - 1,
+}
+
+/**
+ * Values by id in small pages, for ids that come in runs: the values a checker stores for most nodes of
+ * the files it checks, one after another, and reads back as it goes (the symbol an identifier resolved
+ * to). A lookup in a map of them reads a table as large as everything stored, at a place the id's hash
+ * picks; a page holds the values of the 64 ids around the last one.
+ */
+export class NearLinkTable<T> {
+  readonly pages: LinkPage<T>[] = [];
+
+  get(id: number): T | undefined {
+    const page = this.pages[id >> NearPaging.Bits];
+    return page !== undefined ? page[id & NearPaging.Mask] : undefined;
+  }
+
+  set(id: number, value: T | undefined): void {
+    const index = id >> NearPaging.Bits;
+    const page = this.pages[index];
+    if (page !== undefined) page[id & NearPaging.Mask] = value;
+    else if (value !== undefined) {
+      const pages = this.pages;
+      while (pages.length <= index) pages.push(undefined);
+      const created: (T | undefined)[] = [];
+      for (let i = 0; i < NearPaging.Size; i++) created.push(undefined);
+      pages[index] = created;
+      created[id & NearPaging.Mask] = value;
+    }
+  }
+
+  clear(): void {
+    this.pages.length = 0;
+  }
+
+  /** The number of values stored (a count over the pages: for traces). */
+  size(): number {
+    let n = 0;
+    for (const page of this.pages) if (page !== undefined) for (const v of page) if (v !== undefined) n++;
+    return n;
+  }
+}
