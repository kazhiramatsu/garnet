--- a/packages/tsc-ts/src/compiler/checker-symbols.ts
+++ b/packages/tsc-ts/src/compiler/checker-symbols.ts
@@ -951,10 +951,29 @@ export function setGlobal(c: Checker, name: string, symbol: Symbol): void {
 }
 
 function setMergedSymbol(c: Checker, id: number, target: Symbol): void {
+  noteMergedSymbolId(c, id);
   if (c.mergedSymbolChanges !== undefined) c.mergedSymbolChanges.set(c.mergedSymbols, id, target);
   else c.mergedSymbols.set(id, target);
 }
 
+/** Sets the bit of `id` in `c.mergedSymbolIdBits`: `id` is a key of `c.mergedSymbols` from now on. */
+function noteMergedSymbolId(c: Checker, id: number): void {
+  const word = id >>> 5;
+  let bits = c.mergedSymbolIdBits;
+  if (word >= bits.length) {
+    const grown = new Int32Array(Math.max(word + 1, bits.length * 2, 1024));
+    grown.set(bits);
+    bits = grown;
+    c.mergedSymbolIdBits = grown;
+  }
+  bits[word] = bits[word]! | (1 << (id & 31));
+}
+
+/** Sets the bits of the keys `c.mergedSymbols` holds: a checker starts from another's table. */
+export function noteMergedSymbolIds(c: Checker): void {
+  for (const id of c.mergedSymbols.keys()) noteMergedSymbolId(c, id);
+}
