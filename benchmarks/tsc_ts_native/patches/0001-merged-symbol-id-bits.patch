@@ -1294,8 +1313,13 @@ function recordMergedSymbol(c: Checker, target: Symbol, source: Symbol): void {
 export function getMergedSymbol(c: Checker, symbol: Symbol): Symbol {
   const id = symbol.id;
   if (id !== 0) {
-    const merged = c.mergedSymbols.get(id);
-    if (merged !== undefined) return merged;
+    // Few symbols are merged: the id's bit says whether the table can hold it at all.
+    const bits = c.mergedSymbolIdBits;
+    const word = id >>> 5;
+    if (word < bits.length && (bits[word]! & (1 << (id & 31))) !== 0) {
+      const merged = c.mergedSymbols.get(id);
+      if (merged !== undefined) return merged;
+    }
   }
   return symbol;
 }
