index 0000000..938a4a5
--- /dev/null
+++ b/packages/tsc-ts/src/compiler/checker-split.ts
@@ -0,0 +1,347 @@
+// Sharing the statements of one container between a checker and forks of itself.
+//
+// A checker checks a file on one thread, and one file can be most of a program's check: the
+// TypeScript compiler's checker.ts is one function of three megabytes, and the thread that checks
+// it runs twice as long as the threads that check the 77 other files of the compiler, whose
+// processors then wait for it.
+//
+// Where a new thread is a fork of the thread that starts it (garnet's workers are forked processes:
+// a fork has every type, link and cache its checker had, copy-on-write), a checker shares what is
+// left of a huge container's statements, a file's or a top-level function's, as soon as a processor
+// is idle: it starts a fork for that processor, and the checker and its forks take the remaining
+// statements one at a time from a cursor in shared memory. A fork checks the statements it takes and
+// what they queue, sends back the diagnostics it added, and ends. The checker finishes the file as
+// it always does and adds the forks' diagnostics to its own (parallel-check.ts, `ThreadSplit`).
+// Until a processor is idle nothing differs from a checker that does not share.
+//
+// The diagnostics are those of the checker alone:
+// - A statement is checked in full by exactly one process, and what it needs of the other statements
+//   (types, signatures, control flow) is computed on demand by any process alike. A diagnostic two
+//   processes report is one after `sortAndDeduplicateDiagnostics`.
+// - What the checker queued before a fork stays its own: a fork starts with empty queues (deferred
+//   nodes, deferred iteration errors and collision checks, renamed binding elements) and with the
+//   set of the deferred nodes queued so far, so none of them is checked twice or dropped.
+// - A deferred node belongs to the process that takes the statement around it, which reaches it
+//   while it checks the statement. A fork leaves the nodes it reached in other statements (inferring
+//   a return type) to their processes; the checker checks all it queued, what it queued before its
+//   first fork as soon as that fork is started.
+// - A run of unreachable statements is reported by the process that takes its first statement.
+// - A check that a checker runs once for a symbol, at the first of its declarations it checks, and
+//   reports there (an interface's inherited properties), runs at the first of the declarations among
+//   the shared statements, which is the one a checker alone meets first (`checksSymbolAt`).
+// - The grammar checks, the module's exports and whatever else ends a file are the checker's.
+//
+// What needs the side effects of every statement in one process keeps a container whole
+// (`sharesStatements`, and the thread's conditions in parallel-check.ts): unused identifiers, emit
+// and declaration diagnostics, imported helpers, and the names the emit of private identifiers
+// reserves.
+import { type Node, type SourceFile, getBody, getLocals, getStatements } from './ast.js';
+import { getSourceFileOfNode } from './binder-utilities.js';
+import type { Checker } from './checker.js';
+import { checkUnusedRenamedBindingElements } from './checker-declarations.js';
+import { produceDeferredCollisionChecks } from './checker-generated-code.js';
+import { produceDeferredIterationErrors } from './checker-iteration.js';
+import {
+  checkDeferredNode,
+  checkDeferredNodes,
+  checkSourceElement,
+  continuesUnreachableRun,
+} from './checker-source-file.js';
+import { ScriptTarget } from './options.js';
+import type { Symbol } from './symbol.js';
+import { SyntaxKind } from './syntax-kind.js';
+import { mark } from './timeline.js';
+
+/** What the thread of a checker provides to share statements (parallel-check.ts). */
+export interface SplitHost {
+  /** The least text of a container whose statements are shared. */
+  readonly containerText: number;
+  /** The least text left to check for each process that shares it. */
+  readonly forkText: number;
+  /** For tests: only files whose names contain this share statements ('' for every file). */
+  readonly only: string;
+  /** Whether a processor is idle. Called between the statements of a container. */
+  idle(): boolean;
+  /**
+   * Takes an idle processor and starts fork `index` of this thread, which runs `checkForkShare(index)`;
+   * false when no processor is left to take.
+   */
+  fork(index: number): boolean;
+}
+
+/** The statements of a container that a checker shares with its forks. */
+export class StatementSplit {
+  /**
+   * In shared memory: [0] the next statement to take, then who took each statement (0 no one yet, 1
+   * the checker, n + 1 its fork n).
+   */
+  readonly board: Int32Array;
+  /** This process: 0 the checker, n its fork n. */
+  self = 0;
+  /** The forks started. */
+  forks = 0;
+  /** Whether this process took each statement. */
+  mine: Uint8Array;
+  /** `Checker.withinUnreachableCode` where the container's statements are checked. */
+  readonly withinUnreachableCode: boolean;
+  /** Where the shared statements start in the file's text. */
+  readonly sharedFrom: number;
+
+  constructor(
+    readonly c: Checker,
+    readonly host: SplitHost,
+    readonly file: SourceFile,
+    readonly container: Node,
+    readonly statements: readonly Node[],
+    start: number,
+  ) {
+    this.board = new Int32Array(new SharedArrayBuffer(4 * (1 + statements.length)));
+    this.board[0] = start;
+    this.mine = new Uint8Array(statements.length);
+    for (let k = 0; k < start; k++) {
+      this.board[1 + k] = 1;
+      this.mine[k] = 1;
+    }
+    this.withinUnreachableCode = c.withinUnreachableCode;
+    this.sharedFrom = statements[start]!.pos;
+  }
+
+  /** The first declaration of `symbol` of `kind` among the shared statements, if it has one there. */
+  firstShared(symbol: Symbol, kind: SyntaxKind): Node | undefined {
+    let first: Node | undefined = undefined;
+    for (const d of symbol.declarations) {
+      if (d.kind !== kind || d.pos < this.sharedFrom || d.end > this.container.end) continue;
+      if (first !== undefined && first.pos <= d.pos) continue;
+      if (getSourceFileOfNode(d) === this.file) first = d;
+    }
+    return first;
+  }
+
+  /** The index of the statement around `node`, or -1 when `node` is in none of the container's statements. */
+  statementAround(node: Node): number {
+    const statements = this.statements;
+    let lo = 0;
+    let hi = statements.length - 1;
+    while (lo <= hi) {
+      const mid = (lo + hi) >> 1;
+      const statement = statements[mid]!;
+      if (node.end <= statement.pos) hi = mid - 1;
+      else if (node.pos >= statement.end) lo = mid + 1;
+      else return node.pos >= statement.pos && node.end <= statement.end ? mid : -1;
+    }
+    return -1;
+  }
+
+  /**
+   * Whether `node`, a node of the container's file, is this process's to check: one inside a statement
+   * it took, and for the checker one outside the container's statements.
+   */
+  owns(node: Node): boolean {
+    const k = this.statementAround(node);
+    return k < 0 ? this.self === 0 : this.mine[k] === 1;
+  }
+}
+
+/** The statements this process shares: a checker's own, and in a fork those it was started for. */
+let active: StatementSplit | undefined = undefined;
+
+/**
+ * Whether a check of `symbol` that has not run, and that a checker runs once, at the first declaration
+ * of `node`'s kind it checks, runs at `node`. A checker alone meets the declarations among a
+ * container's statements in their order; where the statements are shared, the first of them runs the
+ * check in the process that takes it, and the others leave it to that process.
+ */
+export function checksSymbolAt(symbol: Symbol, node: Node): boolean {
+  const split = active;
+  if (split === undefined || symbol.declarations.length < 2) return true;
+  const first = split.firstShared(symbol, node.kind);
+  return first === undefined || first === node;
+}
+
+/**
+ * Whether the statements of `container`, a file or the body of a function declared at the top of one,
+ * may be shared with forks of the checker.
+ */
+export function sharesStatements(c: Checker, container: Node, statements: readonly Node[]): boolean {
+  const host = c.splitHost;
+  if (host === undefined || statements.length < 2 || container.end - container.pos < host.containerText) return false;
+  if (host.only !== '' && !getSourceFileOfNode(container).fileName.includes(host.only)) return false;
+  return c.languageVersion > ScriptTarget.ES2021 || !declaresReservedName(c, container);
+}
+
+/**
+ * Whether the scope of `container`'s statements declares a name the emit of private identifiers and of
+ * `super` in static initializers reserves: such a declaration is checked against what every statement
+ * of its scope found (checkCollisionsForDeclarationName).
+ */
+function declaresReservedName(c: Checker, container: Node): boolean {
+  const scope = container.kind === SyntaxKind.SourceFile ? container : container.parent!;
+  const locals = getLocals(scope);
+  for (const name of ['WeakMap', 'WeakSet', 'Reflect']) {
+    if (locals !== undefined && locals.has(name)) return true;
+    // The declarations at the top of a script are globals.
+    if (scope.kind !== SyntaxKind.SourceFile) continue;
+    const symbol = c.globals.get(name);
+    if (symbol !== undefined) for (const d of symbol.declarations) if (getSourceFileOfNode(d) === scope) return true;
+  }
+  return false;
+}
+
+/** Whether `node` is a function declaration whose statements may be shared (`sharesStatements`). */
+function isSharedFunction(c: Checker, node: Node): boolean {
+  if (node.kind !== SyntaxKind.FunctionDeclaration) return false;
+  const body = getBody(node);
+  return body !== undefined && body.kind === SyntaxKind.Block && sharesStatements(c, body, getStatements(body)!.nodes);
+}
+
+/** Whether a fork is worth starting for the statements of `container` from `k` on. */
+function worthSharing(c: Checker, host: SplitHost, container: Node, statements: readonly Node[], k: number): boolean {
+  if (container.end - statements[k]!.pos < 2 * host.forkText) return false;
+  // A function whose own statements can be shared is shared from inside, once the checker is there.
+  if (container.kind === SyntaxKind.SourceFile)
+    for (let i = k; i < statements.length; i++) if (isSharedFunction(c, statements[i]!)) return false;
+  return true;
+}
+
+/**
+ * Checks the statements of a container that may be shared (`sharesStatements`): as always until a
+ * processor is idle, then together with forks of this checker.
+ */
+export function checkSharedStatements(c: Checker, container: Node, statements: readonly Node[]): void {
+  const host = c.splitHost!;
+  let k = 0;
+  for (; k < statements.length; k++) {
+    // One container a checker: a function among these statements may have shared its own.
+    if (c.splitHost === undefined) {
+      for (; k < statements.length; k++) checkSourceElement(c, statements[k]!);
+      return;
+    }
+    if (host.idle() && worthSharing(c, host, container, statements, k)) break;
+    checkSourceElement(c, statements[k]!);
+  }
+  if (k === statements.length) return;
+  // Its forks report once this checker has checked its files, so it shares no other container.
+  c.splitHost = undefined;
+  const split = new StatementSplit(c, host, getSourceFileOfNode(container), container, statements, k);
+  c.split = split;
+  active = split;
+  takeStatements(split);
+  mark('statements taken');
+}
+
+/** Takes statements until none is left. The checker starts a fork for each processor that is idle meanwhile. */
+function takeStatements(split: StatementSplit): void {
+  const statements = split.statements;
+  const board = split.board;
+  for (;;) {
+    if (split.self === 0) {
+      const forks = split.forks;
+      startForks(split);
+      // What the checker queued before its first fork is its own to check, and the forks take the
+      // statements meanwhile: checked now, not when the statements have run out and the forks wait.
+      if (forks === 0 && split.forks > 0) {
+        mark(`statements shared from ${Atomics.load(board, 0)} of ${statements.length}`);
+        checkDeferredNodes(split.c, split.file);
+      }
+    }
+    const k = Atomics.add(board, 0, 1);
+    if (k >= statements.length) return;
+    Atomics.store(board, 1 + k, split.self + 1);
+    split.mine[k] = 1;
+    checkTakenStatement(split.c, statements, k);
+  }
+}
+
+function checkTakenStatement(c: Checker, statements: readonly Node[], k: number): void {
+  const statement = statements[k]!;
+  // A run of unreachable statements is reported once, with its first statement: the statements after
+  // it count as reported wherever they are checked.
+  if (
+    k > 0 &&
+    !c.withinUnreachableCode &&
+    c.compilerOptions.allowUnreachableCode !== true &&
+    continuesUnreachableRun(c, statements[k - 1]!, statement)
+  )
+    c.reportedUnreachableNodes.add(statement);
+  checkSourceElement(c, statement);
+}
+
+/** Starts forks while processors are idle and enough text is left for one more process. */
+function startForks(split: StatementSplit): void {
+  const host = split.host;
+  const statements = split.statements;
+  for (;;) {
+    const next = Atomics.load(split.board, 0);
+    if (next >= statements.length) return;
+    const left = split.container.end - statements[next]!.pos;
+    if (left < (split.forks + 2) * host.forkText || !host.idle() || !host.fork(split.forks + 1)) return;
+    split.forks++;
+  }
+}
+
+/**
+ * The share of fork `index`: the statements it takes and what they queue. The diagnostics it adds are
+ * in the log of `Checker.diagnostics`.
+ */
+export function checkForkShare(index: number): StatementSplit {
+  const split = active!;
+  const c = split.c;
+  split.self = index;
+  split.mine = new Uint8Array(split.statements.length);
+  // What the checker queued before this fork is the checker's.
+  const links = c.nodeLinks(split.file);
+  if (links.deferredNodes !== undefined) links.deferredNodes = [];
+  c.deferredIterationErrors = [];
+  c.deferredCollisionChecks = [];
+  c.renamedBindingElementsInTypes.length = 0;
+  c.diagnostics.startLog();
+  takeStatements(split);
+  // Deferred checks may defer more nodes. Those of other statements are checked with their statements.
+  const nodes = links.deferredNodes;
+  if (nodes !== undefined) for (let i = 0; i < nodes.length; i++) if (split.owns(nodes[i]!)) checkDeferredNode(c, nodes[i]!);
+  const renamed = c.renamedBindingElementsInTypes;
+  let kept = 0;
+  for (const element of renamed)
+    if (getSourceFileOfNode(element) === split.file && split.owns(element)) renamed[kept++] = element;
+  renamed.length = kept;
+  checkUnusedRenamedBindingElements(c);
+  c.fileBeingChecked = undefined;
+  c.saveDeferredDiagnostics = false;
+  produceDeferredIterationErrors(c);
+  produceDeferredCollisionChecks(c);
+  return split;
+}
+
+/**
+ * The checker checks what fork `index` took, after the fork failed, and what no process says it took
+ * (a fork that failed between taking a statement and saying so).
+ */
+export function checkFailedShare(split: StatementSplit, index: number): void {
+  const c = split.c;
+  const file = split.file;
+  const statements = split.statements;
+  const board = split.board;
+  const links = c.nodeLinks(file);
+  // As while the file was checked: its nodes are deferred again, to the end of this.
+  links.typeChecked = false;
+  c.fileBeingChecked = file;
+  c.saveDeferredDiagnostics = true;
+  const saveWithinUnreachableCode = c.withinUnreachableCode;
+  c.withinUnreachableCode = split.withinUnreachableCode;
+  for (let k = 0; k < statements.length; k++) {
+    const taker = Atomics.load(board, 1 + k);
+    if (taker !== index + 1 && taker !== 0) continue;
+    Atomics.store(board, 1 + k, 1);
+    split.mine[k] = 1;
+    checkTakenStatement(c, statements, k);
+  }
+  c.withinUnreachableCode = saveWithinUnreachableCode;
+  checkDeferredNodes(c, file);
+  checkUnusedRenamedBindingElements(c);
+  c.fileBeingChecked = undefined;
+  c.saveDeferredDiagnostics = false;
+  produceDeferredIterationErrors(c);
+  produceDeferredCollisionChecks(c);
+  links.typeChecked = true;
+  links.deferredNodes = undefined;
+}
