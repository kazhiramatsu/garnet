+/**
+ * Checks the deferred nodes that are this process's after it took statement `k`: those the statement
+ * queued, those of the statement that were reached before it was taken, and for the checker those
+ * outside the container's statements. The nodes of other statements wait for theirs (`waiting`).
+ */
+function checkOwnDeferred(split: StatementSplit, k: number): void {
+  const c = split.c;
+  const waiting = split.waiting;
+  const earlier = k < waiting.length ? waiting[k] : undefined;
+  if (earlier !== undefined) {
+    waiting[k] = undefined;
+    for (const node of earlier) checkDeferredNode(c, node);
+  }
+  const nodes = c.nodeLinks(split.file).deferredNodes;
+  if (nodes === undefined) return;
+  // Deferred checks may defer more nodes.
+  for (let i = 0; i < nodes.length; i++) {
+    const node = nodes[i]!;
+    const j = split.statementAround(node);
+    if (j < 0 ? split.self === 0 : split.mine[j] === 1) checkDeferredNode(c, node);
+    else if (j >= 0) {
+      while (waiting.length <= j) waiting.push(undefined);
+      const list = waiting[j];
+      if (list === undefined) waiting[j] = [node];
+      else list.push(node);
+    }
   }
+  nodes.length = 0;
