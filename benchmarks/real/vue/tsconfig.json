{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "isolatedDeclarations": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [],
    "lib": [
      "es2022",
      "dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@vue/compiler-core": [
        "packages/compiler-core/src/index.ts"
      ],
      "@vue/compiler-dom": [
        "packages/compiler-dom/src/index.ts"
      ],
      "@vue/compiler-sfc": [
        "packages/compiler-sfc/src/index.ts"
      ],
      "@vue/compiler-ssr": [
        "packages/compiler-ssr/src/index.ts"
      ],
      "@vue/reactivity": [
        "packages/reactivity/src/index.ts"
      ],
      "@vue/runtime-core": [
        "packages/runtime-core/src/index.ts"
      ],
      "@vue/runtime-dom": [
        "packages/runtime-dom/src/index.ts"
      ],
      "@vue/runtime-test": [
        "packages/runtime-test/src/index.ts"
      ],
      "@vue/server-renderer": [
        "packages/server-renderer/src/index.ts"
      ],
      "@vue/shared": [
        "packages/shared/src/index.ts"
      ],
      "vue": [
        "packages/vue/src/index.ts"
      ],
      "@vue/compat": [
        "packages/vue-compat/src/index.ts"
      ],
      "@babel/parser": [
        "garnet-stubs/babel-parser.ts"
      ],
      "@babel/types": [
        "garnet-stubs/babel-types.ts"
      ],
      "entities/decode": [
        "garnet-stubs/entities-decode.ts"
      ],
      "estree-walker": [
        "garnet-stubs/estree-walker.ts"
      ],
      "source-map-js": [
        "garnet-stubs/source-map-js.ts"
      ]
    }
  },
  "include": [],
  "files": [
    "garnet-driver.ts",
    "garnet-stubs/globals.d.ts"
  ]
}
